+libselinux_CPPFLAGS=
+libselinux_LDFLAGS=
+libselinux_LIBS=
+enable_secontext=no
+
+AC_ARG_WITH([libselinux],
+	    [AS_HELP_STRING([--with-libselinux],
+			    [use libselinux to collect security contexts])],
+	    [case "${withval}" in
+	     yes|no|check) ;;
+	     *) with_libselinux=yes
+		libselinux_CPPFLAGS="-I${withval}/include"
+		libselinux_LDFLAGS="-L${withval}/lib" ;;
+	     esac],
+	    [with_libselinux=check]
