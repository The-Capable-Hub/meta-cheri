diff --git a/include/common.h b/include/common.h
index 4dfb588..f3fc647 100644
--- a/include/common.h
+++ b/include/common.h
@@ -7,6 +7,20 @@
  * Print information about a capability
  */
 
+/* TODO: to be implemented */
+uint64_t cheri_flags_get(void *__capability ptr)
+{
+    return 0xdeadbeef;
+}
+
+/* helper functions */
+int cheri_is_address_inbounds (void *__capability ptr, uint64_t addr)
+{
+    uint64_t base = cheri_base_get(ptr);
+    uint32_t len = cheri_length_get(ptr);
+    return (base <= addr) && (addr < (base + len));
+}
+
 void pp_cap(void *__capability ptr)
 {
     uint64_t length = cheri_length_get(ptr);
diff --git a/set_bounds.c b/set_bounds.c
index 390c7dd..2f28308 100644
--- a/set_bounds.c
+++ b/set_bounds.c
@@ -1,12 +1,10 @@
 /***
- * The point of this program is to demonstrate the failing of a program
- * that tries to extend the bounderies of a capable pointer.
- * Compared to the simpler 'bounds.c', here we try to modify the bounds
- * explicitly.
+ * The point of this program is to demonstrate clearing of the valid tag if the
+ * boundaries of a capablility are extended. Compared to the simpler 'bounds.c',
+ * here we try to modify the bounds explicitly.
  ***/
 
 #include "include/common.h"
-#include <cheri/cheric.h>
 #include <stdint.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -35,6 +33,7 @@ int main(int argc, char *argv[])
         // This will cause the test to fail for a value lower than 64
         exit(0);
     }
-    // Trying to extend the bounds generates an exception.
-    int32_t *custom_bounds_array = cheri_setbounds(array, bounds);
+    // Extending bounds will clear the valid tag.
+    int32_t *custom_bounds_array = cheri_bounds_set(array, bounds);
+    pp_cap(custom_bounds_array);
 }
diff --git a/setjmp.c b/setjmp.c
index 4902a54..75ea478 100644
--- a/setjmp.c
+++ b/setjmp.c
@@ -1,5 +1,4 @@
 #include "include/common.h"
-#include <cheri/cheric.h>
 #include <setjmp.h>
 #include <stdint.h>
 #include <stdio.h>
@@ -9,23 +8,23 @@ int main()
     jmp_buf buffer;
     int res = setjmp(buffer);
 
-    uint32_t length = cheri_getlength(buffer);
+    uint32_t length = cheri_length_get(buffer);
 
     // buffer[0] == _JB_MAGIC_SETJMP == 0xbe87fd8a2910af01
     // buffer[1] == $csp
     // buffer[2] == $cfp
     // buffer[3..13] == $cs1..11
     // buffer[14..31] = ???
-    for (uint32_t idx; idx < (length / 16); idx++)
+    for (uint32_t idx = 0; idx < (length / 16); idx++)
     {
-        if (cheri_gettag(((void **) buffer)[idx]))
+        if (cheri_tag_get(((void **) buffer)[idx]))
         {
             void *csp = cheri_getcsp();
-            uint64_t address = cheri_getaddress(((void **) buffer)[idx]);
+            uint64_t address = cheri_address_get(((void **) buffer)[idx]);
 
             if (cheri_is_address_inbounds(csp, address))
             {
-                printf("[STACK POINTER] ");
+                puts("[STACK POINTER] ");
             }
             pp_cap(((void **) buffer)[idx]);
         }
