diff --git a/xor_pointers.c b/xor_pointers.c
index 959a0b4..f8ce383 100644
--- a/xor_pointers.c
+++ b/xor_pointers.c
@@ -21,6 +21,7 @@
        See Section 3.9.1 XOR-linked lists (p56)
  */
 
+#include <stdint.h>
 #include <stdio.h>
 #include <stdlib.h>
 
@@ -35,7 +36,7 @@
 typedef struct cell
 {
     WORD data;
-    WORD ptr;
+    uintptr_t ptr;
 } cell_t;
 
 cell_t *alloc_cell(WORD payload, cell_t *tail)
@@ -44,12 +45,12 @@ cell_t *alloc_cell(WORD payload, cell_t *tail)
     cell->data = payload;
     /* xor this cell's address into the tail's ptr field */
     if (tail != NULL)
-        tail->ptr ^= (WORD) cell;
+        tail->ptr ^= (uintptr_t) cell;
     /* store tail address in this cell's ptr field
      * NOTE most recently allocated cell (i.e. head)
      * only stores a single ptr, not an XOR'd pair
      */
-    cell->ptr = (WORD) tail;
+    cell->ptr = (uintptr_t) tail;
     return cell;
 }
 
@@ -74,7 +75,7 @@ int main()
     {
         printf("%ld\n", curr->data);
         // chase tail
-        next = (cell_t *) ((curr->ptr) ^ (WORD) prev);
+        next = (cell_t *) ((curr->ptr) ^ (uintptr_t) prev);
         // move along one
         prev = curr;
         curr = next;
@@ -83,14 +84,14 @@ int main()
     /* let's traverse back to the start of the list */
     next = curr;
     curr = prev;
-    prev = (cell_t *) ((curr->ptr) ^ (WORD) next);
+    prev = (cell_t *) ((curr->ptr) ^ (uintptr_t) next);
     while (curr != head)
     {
         printf("%ld\n", curr->data);
         // chase reverse tail
         next = curr;
         curr = prev;
-        prev = (cell_t *) ((curr->ptr) ^ (WORD) next);
+        prev = (cell_t *) ((curr->ptr) ^ (uintptr_t) next);
     }
     printf("%ld\n", head->data);
 
